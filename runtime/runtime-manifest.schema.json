{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidenceradar.local/runtime/runtime-manifest.schema.json",
  "title": "EvidenceRadar immutable runtime release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "manifest_version",
    "runtime_version",
    "semantic_contract",
    "python_version",
    "source_commit",
    "git_commit",
    "git_dirty",
    "git_state",
    "immutable_source",
    "state_packaged",
    "artifacts_packaged",
    "execution_lane",
    "execution_host",
    "archive_name",
    "checksum_sidecar",
    "source_date_epoch",
    "file_count",
    "files",
    "required_entrypoints"
  ],
  "properties": {
    "format": {"const": "evidenceradar-runtime-release"},
    "manifest_version": {"const": "1"},
    "runtime_version": {"type": "string", "pattern": "^[0-9A-Za-z][0-9A-Za-z._+-]*$"},
    "semantic_contract": {"const": "3"},
    "python_version": {"const": "3.12"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "git_dirty": {"const": false},
    "git_state": {"const": "clean"},
    "immutable_source": {"const": true},
    "state_packaged": {"const": false},
    "artifacts_packaged": {"const": false},
    "execution_lane": {"const": "github_actions"},
    "execution_host": {"const": "local_runtime"},
    "archive_name": {"type": "string", "pattern": "^EvidenceRadar-Runtime-v.+\\.zip$"},
    "checksum_sidecar": {"type": "string", "pattern": "^EvidenceRadar-Runtime-v.+\\.zip\\.sha256$"},
    "source_date_epoch": {"type": "integer", "minimum": 0},
    "work_pack_version": {"type": "string", "minLength": 1},
    "file_count": {"type": "integer", "minimum": 1},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "size"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size": {"type": "integer", "minimum": 0}
        }
      }
    },
    "required_entrypoints": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
