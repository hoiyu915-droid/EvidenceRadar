{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidenceradar.local/schemas/evidence-radar-translation-response.schema.json",
  "title": "EvidenceRadar ordinary-chatbot translation response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "request_sha256", "items"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "artifact_type": { "const": "EvidenceRadar_TranslationResponse" },
    "request_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["immutable_candidate_id", "title_zh_tw", "summary_zh_tw"],
        "properties": {
          "immutable_candidate_id": { "type": "string", "minLength": 1 },
          "title_zh_tw": { "type": "string", "minLength": 1 },
          "summary_zh_tw": { "type": "string" }
        }
      }
    }
  }
}
