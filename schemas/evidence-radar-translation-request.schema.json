{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidenceradar.local/schemas/evidence-radar-translation-request.schema.json",
  "title": "EvidenceRadar ordinary-chatbot translation request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "run_id",
    "created_at",
    "execution_lane",
    "protocol_commit",
    "base_state_sha256",
    "window",
    "instructions",
    "candidates",
    "resume_context",
    "request_sha256"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "artifact_type": { "const": "EvidenceRadar_TranslationRequest" },
    "run_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "execution_lane": { "enum": ["github_actions"] },
    "protocol_commit": { "type": "string", "minLength": 1 },
    "base_state_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "hours"],
      "properties": {
        "start": { "type": "string", "format": "date-time" },
        "end": { "type": "string", "format": "date-time" },
        "hours": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "instructions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["immutable_candidate_id", "title_en", "source_excerpt", "metadata"],
        "properties": {
          "immutable_candidate_id": { "type": "string", "minLength": 1 },
          "title_en": { "type": "string", "minLength": 1 },
          "source_excerpt": { "type": "string" },
          "metadata": {
            "type": "object",
            "additionalProperties": false,
            "required": ["category", "publication_date", "authors", "identifiers"],
            "properties": {
              "category": { "type": "string", "minLength": 1 },
              "publication_date": { "type": "string", "minLength": 1 },
              "authors": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "venue": { "type": "string" },
              "identifiers": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } }
            }
          }
        }
      }
    },
    "resume_context": { "type": "object" },
    "request_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
