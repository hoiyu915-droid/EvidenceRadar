{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidenceradar.local/schemas/evidence-radar-translation-submission.schema.json",
  "title": "EvidenceRadar Work translation submission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "created_at",
    "handoff_issue_number",
    "request_artifact",
    "response",
    "submission_sha256"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "artifact_type": { "const": "EvidenceRadar_TranslationSubmission" },
    "created_at": { "type": "string", "format": "date-time" },
    "handoff_issue_number": { "type": "integer", "minimum": 1 },
    "request_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "artifact_id",
        "workflow_run_id",
        "artifact_name",
        "request_sha256"
      ],
      "properties": {
        "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "artifact_id": { "type": "integer", "minimum": 1 },
        "workflow_run_id": { "type": "integer", "minimum": 1 },
        "artifact_name": { "type": "string", "minLength": 1 },
        "request_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "artifact_type", "request_sha256", "items"],
      "properties": {
        "schema_version": { "const": "1.0" },
        "artifact_type": { "const": "EvidenceRadar_TranslationResponse" },
        "request_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["immutable_candidate_id", "title_zh_tw", "summary_zh_tw"],
            "properties": {
              "immutable_candidate_id": { "type": "string", "minLength": 1 },
              "title_zh_tw": { "type": "string", "minLength": 1 },
              "summary_zh_tw": { "type": "string" }
            }
          }
        }
      }
    },
    "submission_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
