{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidenceradar.local/schemas/evidence-radar-run.schema.json",
  "title": "EvidenceRadar GPT Work run artifact",
  "description": "Auditable search, verification, coverage and output ledger for one GPT Work run.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "run_id",
    "started_at",
    "finished_at",
    "mode",
    "window",
    "run_status",
    "history_status",
    "coverage_status",
    "queries",
    "source_access",
    "counts",
    "artifacts",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "artifact_type": {
      "type": "string",
      "const": "EvidenceRadar_Run"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "mode": {
      "type": "string",
      "enum": [
        "daily",
        "focused",
        "deep_verify"
      ]
    },
    "window": {
      "$ref": "#/$defs/window"
    },
    "run_status": {
      "type": "string",
      "enum": [
        "COMPLETE",
        "PARTIAL_SOURCE_COVERAGE",
        "SOURCE_ACCESS_GAP",
        "STATE_HISTORY_INCOMPLETE",
        "NO_QUALIFYING_ITEMS"
      ]
    },
    "history_status": {
      "type": "string",
      "enum": [
        "COMPLETE",
        "STATE_HISTORY_INCOMPLETE"
      ]
    },
    "coverage_status": {
      "type": "string",
      "enum": [
        "COMPLETE",
        "PARTIAL_SOURCE_COVERAGE",
        "SOURCE_ACCESS_GAP"
      ]
    },
    "queries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/query"
      }
    },
    "source_access": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source_access"
      }
    },
    "counts": {
      "$ref": "#/$defs/counts"
    },
    "artifacts": {
      "$ref": "#/$defs/artifacts"
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/warning"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end",
        "hours"
      ],
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        },
        "hours": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query_id",
        "category",
        "query",
        "searched_at",
        "source_ids",
        "status",
        "result_count"
      ],
      "properties": {
        "query_id": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "query": {
          "type": "string",
          "minLength": 1
        },
        "searched_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "SUCCESS",
            "PARTIAL",
            "FAILED",
            "NOT_ATTEMPTED"
          ]
        },
        "result_count": {
          "type": "integer",
          "minimum": 0
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "source_access": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "url",
        "accessed_at",
        "status",
        "result_count"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https?://\\S+$"
        },
        "accessed_at": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "type": "string",
          "enum": [
            "SUCCESS",
            "PARTIAL",
            "FAILED",
            "NOT_ATTEMPTED"
          ]
        },
        "result_count": {
          "type": "integer",
          "minimum": 0
        },
        "error": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "queries",
        "raw_candidates",
        "deduplicated_candidates",
        "verified_works",
        "claims",
        "notified_events"
      ],
      "properties": {
        "queries": { "type": "integer", "minimum": 0 },
        "raw_candidates": { "type": "integer", "minimum": 0 },
        "deduplicated_candidates": { "type": "integer", "minimum": 0 },
        "verified_works": { "type": "integer", "minimum": 0 },
        "claims": { "type": "integer", "minimum": 0 },
        "notified_events": { "type": "integer", "minimum": 0 }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "report_html",
        "state_json",
        "evidence_json",
        "run_json"
      ],
      "properties": {
        "report_html": { "type": "string", "minLength": 1 },
        "state_json": { "type": "string", "minLength": 1 },
        "evidence_json": { "type": "string", "minLength": 1 },
        "run_json": { "type": "string", "minLength": 1 }
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "severity"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "type": "string",
          "enum": [
            "INFO",
            "WARNING",
            "ERROR"
          ]
        }
      }
    }
  }
}
