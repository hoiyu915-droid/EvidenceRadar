{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidenceradar.local/schemas/evidence-radar-run.schema.json",
  "title": "EvidenceRadar run artifact",
  "description": "Auditable search, verification, coverage, provenance and output ledger for one execution lane run.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "run_id",
    "started_at",
    "finished_at",
    "mode",
    "window",
    "run_status",
    "history_status",
    "coverage_status",
    "queries",
    "source_access",
    "source_coverage",
    "counts",
    "artifacts",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "artifact_type": {
      "type": "string",
      "const": "EvidenceRadar_Run"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "resolved_stream_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "resolved_source_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "master_control_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "runtime_request_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "mode": {
      "type": "string",
      "enum": [
        "daily",
        "focused",
        "deep_verify"
      ]
    },
    "window": {
      "$ref": "#/$defs/window"
    },
    "run_status": {
      "type": "string",
      "enum": [
        "COMPLETE",
        "PARTIAL_SOURCE_COVERAGE",
        "SOURCE_ACCESS_GAP",
        "STATE_HISTORY_INCOMPLETE",
        "NO_QUALIFYING_ITEMS"
      ]
    },
    "history_status": {
      "type": "string",
      "enum": [
        "COMPLETE",
        "STATE_HISTORY_INCOMPLETE"
      ]
    },
    "coverage_status": {
      "type": "string",
      "enum": [
        "COMPLETE",
        "PARTIAL_SOURCE_COVERAGE",
        "SOURCE_ACCESS_GAP"
      ]
    },
    "queries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/query"
      }
    },
    "source_access": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source_access"
      }
    },
    "retrieval_attempts": {
      "type": "array",
      "items": { "$ref": "#/$defs/retrieval_attempt" }
    },
    "search_expansions": {
      "type": "array",
      "items": { "$ref": "#/$defs/search_expansion" }
    },
    "followup_attempts": {
      "type": "array",
      "items": { "$ref": "#/$defs/followup_attempt" }
    },
    "rendering": {
      "$ref": "#/$defs/rendering"
    },
    "report_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_coverage": {
      "$ref": "#/$defs/source_coverage"
    },
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/candidate"
      }
    },
    "counts": {
      "$ref": "#/$defs/counts"
    },
    "artifacts": {
      "$ref": "#/$defs/artifacts"
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/warning"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "execution_lane": {
      "type": "string",
      "enum": [
        "github_actions",
        "chatgpt_work"
      ]
    },
    "protocol_commit": {
      "type": "string",
      "minLength": 1
    },
    "base_state_sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "parent_run_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end",
        "hours"
      ],
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        },
        "hours": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query_id",
        "category",
        "query",
        "searched_at",
        "source_ids",
        "status",
        "result_count"
      ],
      "properties": {
        "query_id": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "query": {
          "type": "string",
          "minLength": 1
        },
        "searched_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "SUCCESS",
            "NO_RESULTS",
            "PARTIAL",
            "FAILED",
            "NOT_ATTEMPTED"
          ]
        },
        "result_count": {
          "description": "Records matched by this query after source filtering; unmatched provider inventory records are excluded.",
          "type": "integer",
          "minimum": 0
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "retrieval_attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_id",
        "stage",
        "source_id",
        "attempted_at",
        "status",
        "endpoint",
        "request_fingerprint",
        "receipt_origin",
        "result_count",
        "result_ids_sha256",
        "pagination",
        "limit_reached"
      ],
      "properties": {
        "attempt_id": { "type": "string", "minLength": 1 },
        "stage": {
          "type": "string",
          "enum": ["DISCOVERY", "CONTENT_FETCH", "CLAIM_VERIFY", "FOLLOWUP"]
        },
        "source_id": { "type": "string", "minLength": 1 },
        "source_access_id": { "type": "string", "minLength": 1 },
        "query_id": { "type": "string", "minLength": 1 },
        "work_id": { "type": "string", "minLength": 1 },
        "attempted_at": { "type": "string", "format": "date-time" },
        "status": {
          "type": "string",
          "enum": ["SUCCESS", "NO_RESULTS", "PARTIAL", "FAILED", "NOT_ATTEMPTED"]
        },
        "endpoint": { "type": "string", "minLength": 1 },
        "requested_query": { "type": "string", "minLength": 1 },
        "actual_query": { "type": "string", "minLength": 1 },
        "request_limit": { "type": "integer", "minimum": 1 },
        "request_fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "receipt_origin": { "type": "string", "const": "EXECUTOR" },
        "result_count": { "type": "integer", "minimum": 0 },
        "result_ids_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "pagination": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pages_requested", "pages_received"],
          "properties": {
            "pages_requested": { "type": "integer", "minimum": 0 },
            "pages_received": { "type": "integer", "minimum": 0 },
            "cursor": { "type": "string" }
          }
        },
        "limit_reached": { "type": "boolean" },
        "error_class": { "type": "string", "minLength": 1 },
        "notes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "search_expansion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expansion_id", "query_id", "source_id", "original_query", "expanded_query", "reason"],
      "properties": {
        "expansion_id": { "type": "string", "minLength": 1 },
        "query_id": { "type": "string", "minLength": 1 },
        "source_id": { "type": "string", "minLength": 1 },
        "original_query": { "type": "string", "minLength": 1 },
        "expanded_query": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "followup_attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "followup_id", "gap_id", "trigger", "scope_type", "scope_id",
        "attempt_id", "query", "source_backend", "attempted_at", "result",
        "resolved_gap_ids", "outcome"
      ],
      "properties": {
        "followup_id": { "type": "string", "minLength": 1 },
        "gap_id": { "type": "string", "minLength": 1 },
        "trigger": {
          "type": "string",
          "enum": [
            "PRIMARY_SOURCE_MISSING", "FULLTEXT_MISSING", "IDENTIFIER_CONFLICT",
            "NUMERIC_CONFLICT", "POPULATION_GAP", "FORMAL_VERSION_UNRESOLVED",
            "PREPRINT_TO_VOR_CHECK", "CLAIM_CONTRADICTION"
          ]
        },
        "scope_type": { "type": "string", "enum": ["SOURCE_SYSTEM", "SOURCE", "WORK", "CLAIM"] },
        "scope_id": { "type": "string", "minLength": 1 },
        "parent_candidate_id": { "type": "string", "minLength": 1 },
        "attempt_id": { "type": "string", "minLength": 1 },
        "query": { "type": "string", "minLength": 1 },
        "source_backend": { "type": "string", "minLength": 1 },
        "attempted_at": { "type": "string", "format": "date-time" },
        "result": {
          "type": "string",
          "enum": ["SUCCESS", "NO_RESULTS", "PARTIAL", "FAILED"]
        },
        "resolved_gap_ids": {
          "type": "array", "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "outcome": { "type": "string", "enum": ["RESOLVED", "STILL_OPEN", "DEFERRED"] }
      }
    },
    "rendering": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "renderer_id",
        "featured_target_per_category",
        "featured_hard_max_per_category",
        "featured_excluded_event_classes",
        "publisher_target_min",
        "publisher_hard_max"
      ],
      "properties": {
        "renderer_id": { "type": "string", "const": "evidenceradar-html-v3" },
        "featured_target_per_category": { "type": "integer", "minimum": 1 },
        "featured_hard_max_per_category": { "type": "integer", "minimum": 1 },
        "featured_excluded_event_classes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "publisher_target_min": { "type": "integer", "minimum": 0, "maximum": 15 },
        "publisher_hard_max": { "type": "integer", "minimum": 0, "maximum": 15 }
      }
    },
    "topic_alignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterion_id", "status", "basis"],
      "properties": {
        "criterion_id": { "type": "string", "minLength": 1 },
        "status": {
          "type": "string",
          "enum": ["DIRECT", "PARTIAL", "MECHANISM_CONFLICT", "OUT_OF_SCOPE", "UNCERTAIN"]
        },
        "basis": { "type": "string", "enum": ["RULE", "FULLTEXT", "ABSTRACT", "MODEL_INFERENCE"] },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "source_access": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "url",
        "accessed_at",
        "status",
        "result_count"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https?://\\S+$"
        },
        "accessed_at": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "type": "string",
          "enum": [
            "SUCCESS",
            "NO_RESULTS",
            "PARTIAL",
            "FAILED",
            "NOT_ATTEMPTED"
          ]
        },
        "result_count": {
          "description": "Records matched by this source-access operation after query filtering. For inventory-backed sources, NO_RESULTS requires 0 even when window_record_count is non-zero.",
          "type": "integer",
          "minimum": 0
        },
        "retrieval_complete": {
          "type": "boolean"
        },
        "retrieval_backend": {
          "type": "string",
          "minLength": 1
        },
        "feed_entry_count": {
          "type": "integer",
          "minimum": 0
        },
        "registry_record_count": {
          "type": "integer",
          "minimum": 0
        },
        "unusable_record_count": {
          "type": "integer",
          "minimum": 0
        },
        "window_record_count": {
          "description": "Complete de-duplicated provider records in the monitoring window before per-query filtering; this is inventory telemetry, not query matches.",
          "type": "integer",
          "minimum": 0
        },
        "inventory_url": {
          "type": "string",
          "pattern": "^https?://\\S+$"
        },
        "inventory_pages_requested": {
          "description": "Provider inventory HTTP pages requested once per cached feed/registry snapshot.",
          "type": "integer",
          "minimum": 0
        },
        "inventory_pages_received": {
          "description": "Provider inventory HTTP pages received once per cached feed/registry snapshot.",
          "type": "integer",
          "minimum": 0
        },
        "http_requests_attempted": {
          "description": "Actual HTTP requests attempted by this executor operation, including retries and pagination.",
          "type": "integer",
          "minimum": 0
        },
        "http_responses_received": {
          "description": "Actual HTTP responses returned to this executor operation.",
          "type": "integer",
          "minimum": 0
        },
        "cache_reused": {
          "description": "True only when this operation evaluated an inventory fetched earlier in the same run without new HTTP I/O.",
          "type": "boolean"
        },
        "observation_errors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "work_id": {
          "type": "string",
          "minLength": 1
        },
        "candidate_title": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "http_status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "error": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "source_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "stage",
        "status",
        "checked_at",
        "result_count",
        "summary"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "type": "string",
          "enum": [
            "discovery",
            "bounded_verification"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "SUCCESS",
            "NO_RESULTS",
            "FAILED",
            "NOT_ATTEMPTED"
          ]
        },
        "checked_at": {
          "type": "string",
          "format": "date-time"
        },
        "result_count": {
          "description": "Total per-query matches across the source receipts summarized by this CHECK; unmatched inventory records are excluded.",
          "type": "integer",
          "minimum": 0
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https?://\\S+$"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "source_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested",
        "checked",
        "searched",
        "unavailable",
        "all_configured_sources_checked",
        "checks"
      ],
      "properties": {
        "requested": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "checked": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "searched": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "unavailable": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "all_configured_sources_checked": {
          "type": "boolean"
        },
        "checks": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/source_check"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "identifiers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "doi": { "type": "string", "minLength": 1 },
        "pmid": { "type": "string", "minLength": 1 },
        "pmcid": { "type": "string", "minLength": 1 },
        "arxiv_id": { "type": "string", "minLength": 1 },
        "anthology_id": { "type": "string", "minLength": 1 },
        "openalex_id": { "type": "string", "minLength": 1 }
      }
    },
    "candidate_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_type",
        "occurred_at",
        "source",
        "source_field",
        "precision",
        "confidence"
      ],
      "properties": {
        "event_type": { "type": "string", "minLength": 1 },
        "occurred_at": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "source_field": { "type": "string", "minLength": 1 },
        "source_url": { "type": "string", "pattern": "^https?://\\S+$" },
        "precision": { "type": "string", "minLength": 1 },
        "confidence": { "type": "string", "minLength": 1 }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work_id",
        "title",
        "category",
        "streams",
        "discovery_sources",
        "query_ids",
        "identifiers",
        "publication_date",
        "authors",
        "routing_score",
        "triage_status",
        "triage_reasons",
        "event_status",
        "qualifying_event",
        "publisher_access_status",
        "publisher_access_reason",
        "review_status",
        "source_urls",
        "displayed_in_report",
        "is_preprint"
      ],
      "properties": {
        "work_id": { "type": "string", "minLength": 1 },
        "identity_status": { "type": "string", "enum": ["RESOLVED", "UNRESOLVED", "CONFLICT"] },
        "title": { "type": "string", "minLength": 1 },
        "title_zh_tw": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "streams": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "discovery_sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "query_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "identifiers": { "$ref": "#/$defs/identifiers" },
        "publication_date": { "type": "string", "minLength": 1 },
        "authors": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "content_summary": { "type": "string", "minLength": 1 },
        "summary_basis": {
          "type": "string",
          "enum": [
            "TRANSLATED_ABSTRACT_EXCERPT_ZH_TW",
            "PROVIDER_ABSTRACT_ZH_TW",
            "ZH_TW_METADATA_TEMPLATE",
            "TITLE_ONLY_ZH_TW",
            "PROVIDER_ABSTRACT_EXCERPT",
            "TITLE_ONLY",
            "TRANSLATED_TITLE_ZH_TW_OPENAI",
            "TRANSLATED_TITLE_AND_ABSTRACT_ZH_TW_OPENAI",
            "TRANSLATED_TITLE_ZH_TW_COPILOT",
            "TRANSLATED_TITLE_AND_ABSTRACT_ZH_TW_COPILOT",
            "CHATBOT_TITLE_ZH_TW",
            "CHATBOT_TITLE_AND_ABSTRACT_ZH_TW"
          ]
        },
        "summary_language": { "type": "string", "const": "zh-TW" },
        "venue": { "type": "string", "minLength": 1 },
        "routing_score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "triage_status": {
          "type": "string",
          "enum": ["PRIORITY", "REVIEW_REQUIRED", "LOWER_PRIORITY"]
        },
        "triage_reasons": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "event_status": {
          "type": "string",
          "enum": ["QUALIFYING", "ALREADY_NOTIFIED", "NO_QUALIFYING_EVENT"]
        },
        "event_id": { "type": "string", "minLength": 1 },
        "event_class": {
          "type": "string",
          "enum": ["NEW_PUBLICATION", "BACKFILL_INDEXING", "CORRECTION_NOTICE", "OTHER"]
        },
        "qualifying_event": {
          "anyOf": [
            { "$ref": "#/$defs/candidate_event" },
            { "type": "null" }
          ]
        },
        "publisher_access_status": {
          "type": "string",
          "enum": ["SUCCESS", "FAILED", "NOT_ATTEMPTED"]
        },
        "publisher_access_reason": { "type": "string", "minLength": 1 },
        "publisher_access_id": { "type": "string", "minLength": 1 },
        "publisher_http_status": { "type": "integer", "minimum": 100, "maximum": 599 },
        "publisher_error": { "type": "string", "minLength": 1 },
        "review_status": {
          "type": "string",
          "enum": ["UNREVIEWED", "IN_REVIEW", "VERIFIED", "REJECTED"]
        },
        "source_urls": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^https?://\\S+$" }
        },
        "displayed_in_report": { "type": "boolean" },
        "open_access": { "type": "boolean" },
        "oa_status": {
          "type": "string",
          "enum": ["YES", "NO", "UNKNOWN"]
        },
        "oa_evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/oa_evidence" }
        },
        "access_status": {
          "type": "string",
          "enum": ["ACCESSIBLE", "BLOCKED", "PAYWALLED", "FAILED", "NOT_CHECKED"]
        },
        "access_depth": { "type": "string", "enum": ["NONE", "METADATA", "LANDING_PAGE", "ABSTRACT", "FULL_TEXT"] },
        "access_outcome": { "type": "string", "enum": ["ACCESSIBLE", "BLOCKED", "PAYWALLED", "FAILED", "NOT_ATTEMPTED", "NOT_CHECKED"] },
        "fulltext_kind": {
          "type": "string",
          "enum": ["PDF", "HTML", "REPOSITORY", "ABSTRACT_ONLY", "UNKNOWN"]
        },
        "fulltext_locations": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/fulltext_location" }
        },
        "fulltext_access_status": {
          "type": "string",
          "enum": [
            "ACCESSIBLE",
            "BLOCKED",
            "PAYWALLED",
            "FAILED",
            "NOT_CHECKED",
            "MIXED",
            "UNKNOWN"
          ]
        },
        "download_urls": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^https?://\\S+$" }
        },
        "topic_alignments": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/topic_alignment" }
        },
        "is_preprint": { "type": "boolean" },
        "provider_publication_types": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "document_type": {
          "type": "string",
          "enum": ["journal_article", "preprint", "conference_paper", "protocol", "guideline", "other", "unknown"]
        },
        "document_type_basis": {
          "type": "string",
          "enum": ["PROVIDER_METADATA", "TITLE_EXPLICIT", "PROVIDER_METADATA_AND_TITLE", "SOURCE_CLASS", "UNKNOWN"]
        },
        "study_designs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["randomized_controlled_trial", "clinical_trial", "systematic_review", "meta_analysis", "scoping_review", "review", "cohort_study", "case_control_study", "cross_sectional_study", "case_report", "qualitative_study", "observational_study", "animal_study", "in_vitro_study", "computational_study", "protocol"]
          }
        },
        "study_design_basis": {
          "type": "string",
          "enum": ["PROVIDER_METADATA", "TITLE_EXPLICIT", "PROVIDER_METADATA_AND_TITLE", "SOURCE_CLASS", "UNKNOWN"]
        }
      }
    },
    "oa_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "evidence_type", "value"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "evidence_type": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https?://\\S+" }
      }
    },
    "fulltext_location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "kind", "host_type", "access_status"],
      "properties": {
        "url": { "type": "string", "pattern": "^https?://\\S+$" },
        "kind": { "type": "string", "enum": ["PDF", "HTML", "REPOSITORY"] },
        "host_type": { "type": "string", "enum": ["REPOSITORY", "PUBLISHER"] },
        "access_status": {
          "type": "string",
          "enum": ["ACCESSIBLE", "BLOCKED", "PAYWALLED", "FAILED", "NOT_CHECKED"]
        },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "queries",
        "raw_candidates",
        "deduplicated_candidates",
        "verified_works",
        "claims",
        "notified_events"
      ],
      "properties": {
        "queries": { "type": "integer", "minimum": 0 },
        "sources_requested": { "type": "integer", "minimum": 0 },
        "sources_checked": { "type": "integer", "minimum": 0 },
        "sources_searched": { "type": "integer", "minimum": 0 },
        "sources_unavailable": { "type": "integer", "minimum": 0 },
        "raw_candidates": { "type": "integer", "minimum": 0 },
        "deduplicated_candidates": { "type": "integer", "minimum": 0 },
        "priority_candidates": { "type": "integer", "minimum": 0 },
        "lower_priority_candidates": { "type": "integer", "minimum": 0 },
        "qualifying_event_candidates": { "type": "integer", "minimum": 0 },
        "publisher_attempted": { "type": "integer", "minimum": 0, "maximum": 15 },
        "publisher_accessible": { "type": "integer", "minimum": 0, "maximum": 15 },
        "publisher_failed": { "type": "integer", "minimum": 0, "maximum": 15 },
        "publisher_not_attempted": { "type": "integer", "minimum": 0 },
        "displayed_candidates": { "type": "integer", "minimum": 0 },
        "featured_candidates": { "type": "integer", "minimum": 0 },
        "oa_yes": { "type": "integer", "minimum": 0 },
        "oa_no": { "type": "integer", "minimum": 0 },
        "oa_unknown": { "type": "integer", "minimum": 0 },
        "fulltext_accessible": { "type": "integer", "minimum": 0 },
        "fulltext_blocked": { "type": "integer", "minimum": 0 },
        "fulltext_paywalled": { "type": "integer", "minimum": 0 },
        "fulltext_failed": { "type": "integer", "minimum": 0 },
        "fulltext_not_checked": { "type": "integer", "minimum": 0 },
        "summaries_translated_zh_tw": { "type": "integer", "minimum": 0 },
        "summaries_fallback_zh_tw": { "type": "integer", "minimum": 0 },
        "review_pending": { "type": "integer", "minimum": 0 },
        "verified_works": { "type": "integer", "minimum": 0 },
        "claims": { "type": "integer", "minimum": 0 },
        "notified_events": { "type": "integer", "minimum": 0 }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "report_html",
        "state_json",
        "evidence_json",
        "run_json"
      ],
      "properties": {
        "report_html": { "type": "string", "minLength": 1 },
        "state_json": { "type": "string", "minLength": 1 },
        "evidence_json": { "type": "string", "minLength": 1 },
        "run_json": { "type": "string", "minLength": 1 }
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "severity"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "type": "string",
          "enum": [
            "INFO",
            "WARNING",
            "ERROR"
          ]
        }
      }
    }
  }
}
