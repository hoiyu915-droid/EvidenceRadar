{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidenceradar.local/schemas/evidence-radar-run.schema.json",
  "title": "EvidenceRadar run artifact",
  "description": "Auditable search, verification, coverage, provenance and output ledger for one execution lane run.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "run_id",
    "started_at",
    "finished_at",
    "mode",
    "window",
    "run_status",
    "history_status",
    "coverage_status",
    "queries",
    "source_access",
    "source_coverage",
    "counts",
    "artifacts",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "artifact_type": {
      "type": "string",
      "const": "EvidenceRadar_Run"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "mode": {
      "type": "string",
      "enum": [
        "daily",
        "focused",
        "deep_verify"
      ]
    },
    "window": {
      "$ref": "#/$defs/window"
    },
    "run_status": {
      "type": "string",
      "enum": [
        "COMPLETE",
        "PARTIAL_SOURCE_COVERAGE",
        "SOURCE_ACCESS_GAP",
        "STATE_HISTORY_INCOMPLETE",
        "NO_QUALIFYING_ITEMS"
      ]
    },
    "history_status": {
      "type": "string",
      "enum": [
        "COMPLETE",
        "STATE_HISTORY_INCOMPLETE"
      ]
    },
    "coverage_status": {
      "type": "string",
      "enum": [
        "COMPLETE",
        "PARTIAL_SOURCE_COVERAGE",
        "SOURCE_ACCESS_GAP"
      ]
    },
    "queries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/query"
      }
    },
    "source_access": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source_access"
      }
    },
    "source_coverage": {
      "$ref": "#/$defs/source_coverage"
    },
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/candidate"
      }
    },
    "counts": {
      "$ref": "#/$defs/counts"
    },
    "artifacts": {
      "$ref": "#/$defs/artifacts"
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/warning"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "execution_lane": {
      "type": "string",
      "enum": [
        "github_actions",
        "chatgpt_work"
      ]
    },
    "protocol_commit": {
      "type": "string",
      "minLength": 1
    },
    "base_state_sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "parent_run_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end",
        "hours"
      ],
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        },
        "hours": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query_id",
        "category",
        "query",
        "searched_at",
        "source_ids",
        "status",
        "result_count"
      ],
      "properties": {
        "query_id": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "query": {
          "type": "string",
          "minLength": 1
        },
        "searched_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "SUCCESS",
            "NO_RESULTS",
            "PARTIAL",
            "FAILED",
            "NOT_ATTEMPTED"
          ]
        },
        "result_count": {
          "type": "integer",
          "minimum": 0
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "source_access": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "url",
        "accessed_at",
        "status",
        "result_count"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https?://\\S+$"
        },
        "accessed_at": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "type": "string",
          "enum": [
            "SUCCESS",
            "NO_RESULTS",
            "PARTIAL",
            "FAILED",
            "NOT_ATTEMPTED"
          ]
        },
        "result_count": {
          "type": "integer",
          "minimum": 0
        },
        "work_id": {
          "type": "string",
          "minLength": 1
        },
        "candidate_title": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "http_status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "error": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "source_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "stage",
        "status",
        "checked_at",
        "result_count",
        "summary"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "type": "string",
          "enum": [
            "discovery",
            "bounded_verification"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "SUCCESS",
            "NO_RESULTS",
            "FAILED",
            "NOT_ATTEMPTED"
          ]
        },
        "checked_at": {
          "type": "string",
          "format": "date-time"
        },
        "result_count": {
          "type": "integer",
          "minimum": 0
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https?://\\S+$"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "source_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested",
        "checked",
        "searched",
        "unavailable",
        "all_configured_sources_checked",
        "checks"
      ],
      "properties": {
        "requested": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "checked": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "searched": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "unavailable": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "all_configured_sources_checked": {
          "type": "boolean"
        },
        "checks": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/source_check"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "identifiers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "doi": { "type": "string", "minLength": 1 },
        "pmid": { "type": "string", "minLength": 1 },
        "pmcid": { "type": "string", "minLength": 1 },
        "arxiv_id": { "type": "string", "minLength": 1 },
        "anthology_id": { "type": "string", "minLength": 1 },
        "openalex_id": { "type": "string", "minLength": 1 }
      }
    },
    "candidate_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_type",
        "occurred_at",
        "source",
        "source_field",
        "precision",
        "confidence"
      ],
      "properties": {
        "event_type": { "type": "string", "minLength": 1 },
        "occurred_at": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "source_field": { "type": "string", "minLength": 1 },
        "source_url": { "type": "string", "pattern": "^https?://\\S+$" },
        "precision": { "type": "string", "minLength": 1 },
        "confidence": { "type": "string", "minLength": 1 }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work_id",
        "title",
        "category",
        "streams",
        "discovery_sources",
        "query_ids",
        "identifiers",
        "publication_date",
        "authors",
        "routing_score",
        "triage_status",
        "triage_reasons",
        "event_status",
        "qualifying_event",
        "publisher_access_status",
        "publisher_access_reason",
        "review_status",
        "source_urls",
        "displayed_in_report",
        "is_preprint"
      ],
      "properties": {
        "work_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "streams": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "discovery_sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "query_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "identifiers": { "$ref": "#/$defs/identifiers" },
        "publication_date": { "type": "string", "minLength": 1 },
        "authors": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "content_summary": { "type": "string", "minLength": 1 },
        "summary_basis": {
          "type": "string",
          "enum": [
            "TRANSLATED_ABSTRACT_EXCERPT_ZH_TW",
            "PROVIDER_ABSTRACT_ZH_TW",
            "ZH_TW_METADATA_TEMPLATE",
            "TITLE_ONLY_ZH_TW",
            "PROVIDER_ABSTRACT_EXCERPT",
            "TITLE_ONLY"
          ]
        },
        "summary_language": { "type": "string", "const": "zh-TW" },
        "venue": { "type": "string", "minLength": 1 },
        "routing_score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "triage_status": {
          "type": "string",
          "enum": ["PRIORITY", "REVIEW_REQUIRED", "LOWER_PRIORITY"]
        },
        "triage_reasons": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "event_status": {
          "type": "string",
          "enum": ["QUALIFYING", "ALREADY_NOTIFIED", "NO_QUALIFYING_EVENT"]
        },
        "event_id": { "type": "string", "minLength": 1 },
        "event_class": {
          "type": "string",
          "enum": ["NEW_PUBLICATION", "BACKFILL_INDEXING", "CORRECTION_NOTICE", "OTHER"]
        },
        "qualifying_event": {
          "anyOf": [
            { "$ref": "#/$defs/candidate_event" },
            { "type": "null" }
          ]
        },
        "publisher_access_status": {
          "type": "string",
          "enum": ["SUCCESS", "FAILED", "NOT_ATTEMPTED"]
        },
        "publisher_access_reason": { "type": "string", "minLength": 1 },
        "publisher_access_id": { "type": "string", "minLength": 1 },
        "publisher_http_status": { "type": "integer", "minimum": 100, "maximum": 599 },
        "publisher_error": { "type": "string", "minLength": 1 },
        "review_status": {
          "type": "string",
          "enum": ["UNREVIEWED", "IN_REVIEW", "VERIFIED", "REJECTED"]
        },
        "source_urls": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^https?://\\S+$" }
        },
        "displayed_in_report": { "type": "boolean" },
        "open_access": { "type": "boolean" },
        "oa_status": {
          "type": "string",
          "enum": ["YES", "NO", "UNKNOWN"]
        },
        "oa_evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/oa_evidence" }
        },
        "access_status": {
          "type": "string",
          "enum": ["ACCESSIBLE", "BLOCKED", "PAYWALLED", "FAILED", "NOT_CHECKED"]
        },
        "fulltext_kind": {
          "type": "string",
          "enum": ["PDF", "HTML", "REPOSITORY", "ABSTRACT_ONLY", "UNKNOWN"]
        },
        "fulltext_locations": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/fulltext_location" }
        },
        "fulltext_access_status": {
          "type": "string",
          "enum": [
            "ACCESSIBLE",
            "BLOCKED",
            "PAYWALLED",
            "FAILED",
            "NOT_CHECKED",
            "MIXED",
            "UNKNOWN"
          ]
        },
        "download_urls": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^https?://\\S+$" }
        },
        "is_preprint": { "type": "boolean" }
      }
    },
    "oa_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "evidence_type", "value"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "evidence_type": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https?://\\S+" }
      }
    },
    "fulltext_location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "kind", "host_type", "access_status"],
      "properties": {
        "url": { "type": "string", "pattern": "^https?://\\S+$" },
        "kind": { "type": "string", "enum": ["PDF", "HTML", "REPOSITORY"] },
        "host_type": { "type": "string", "enum": ["REPOSITORY", "PUBLISHER"] },
        "access_status": {
          "type": "string",
          "enum": ["ACCESSIBLE", "BLOCKED", "PAYWALLED", "FAILED", "NOT_CHECKED"]
        },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "queries",
        "raw_candidates",
        "deduplicated_candidates",
        "verified_works",
        "claims",
        "notified_events"
      ],
      "properties": {
        "queries": { "type": "integer", "minimum": 0 },
        "sources_requested": { "type": "integer", "minimum": 0 },
        "sources_checked": { "type": "integer", "minimum": 0 },
        "sources_searched": { "type": "integer", "minimum": 0 },
        "sources_unavailable": { "type": "integer", "minimum": 0 },
        "raw_candidates": { "type": "integer", "minimum": 0 },
        "deduplicated_candidates": { "type": "integer", "minimum": 0 },
        "priority_candidates": { "type": "integer", "minimum": 0 },
        "lower_priority_candidates": { "type": "integer", "minimum": 0 },
        "qualifying_event_candidates": { "type": "integer", "minimum": 0 },
        "publisher_attempted": { "type": "integer", "minimum": 0, "maximum": 15 },
        "publisher_accessible": { "type": "integer", "minimum": 0, "maximum": 15 },
        "publisher_failed": { "type": "integer", "minimum": 0, "maximum": 15 },
        "publisher_not_attempted": { "type": "integer", "minimum": 0 },
        "displayed_candidates": { "type": "integer", "minimum": 0 },
        "featured_candidates": { "type": "integer", "minimum": 0 },
        "oa_yes": { "type": "integer", "minimum": 0 },
        "oa_no": { "type": "integer", "minimum": 0 },
        "oa_unknown": { "type": "integer", "minimum": 0 },
        "fulltext_accessible": { "type": "integer", "minimum": 0 },
        "fulltext_blocked": { "type": "integer", "minimum": 0 },
        "fulltext_paywalled": { "type": "integer", "minimum": 0 },
        "fulltext_failed": { "type": "integer", "minimum": 0 },
        "fulltext_not_checked": { "type": "integer", "minimum": 0 },
        "summaries_translated_zh_tw": { "type": "integer", "minimum": 0 },
        "summaries_fallback_zh_tw": { "type": "integer", "minimum": 0 },
        "review_pending": { "type": "integer", "minimum": 0 },
        "verified_works": { "type": "integer", "minimum": 0 },
        "claims": { "type": "integer", "minimum": 0 },
        "notified_events": { "type": "integer", "minimum": 0 }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "report_html",
        "state_json",
        "evidence_json",
        "run_json"
      ],
      "properties": {
        "report_html": { "type": "string", "minLength": 1 },
        "state_json": { "type": "string", "minLength": 1 },
        "evidence_json": { "type": "string", "minLength": 1 },
        "run_json": { "type": "string", "minLength": 1 }
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "severity"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "type": "string",
          "enum": [
            "INFO",
            "WARNING",
            "ERROR"
          ]
        }
      }
    }
  }
}
