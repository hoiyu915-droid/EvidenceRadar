{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidenceradar.local/schemas/evidence-radar-state.schema.json",
  "title": "EvidenceRadar GPT Work state artifact",
  "description": "Cross-run identity and notification state. This is a data artifact, not a runtime contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "generated_at",
    "timezone",
    "history_status",
    "dedupe_priority",
    "works",
    "notified_events"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "artifact_type": {
      "type": "string",
      "const": "EvidenceRadar_State"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "timezone": {
      "type": "string",
      "minLength": 1
    },
    "history_status": {
      "type": "string",
      "enum": [
        "COMPLETE",
        "STATE_HISTORY_INCOMPLETE"
      ]
    },
    "history_note": {
      "type": "string",
      "minLength": 1
    },
    "last_run_id": {
      "type": "string",
      "minLength": 1
    },
    "dedupe_priority": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "doi",
          "pmid",
          "pmcid",
          "arxiv_id",
          "anthology_id",
          "openalex_id",
          "normalized_title"
        ]
      }
    },
    "works": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/work"
      }
    },
    "notified_events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/notified_event"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "identifiers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "doi": {
          "type": "string",
          "minLength": 1
        },
        "pmid": {
          "type": "string",
          "minLength": 1
        },
        "pmcid": {
          "type": "string",
          "minLength": 1
        },
        "arxiv_id": {
          "type": "string",
          "minLength": 1
        },
        "anthology_id": {
          "type": "string",
          "minLength": 1
        },
        "openalex_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "work": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work_id",
        "title",
        "normalized_title",
        "identifiers",
        "first_seen_at",
        "last_seen_at",
        "seen_count",
        "notified_event_ids"
      ],
      "properties": {
        "work_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "normalized_title": {
          "type": "string",
          "minLength": 1
        },
        "identifiers": {
          "$ref": "#/$defs/identifiers"
        },
        "first_seen_at": {
          "type": "string",
          "format": "date-time"
        },
        "last_seen_at": {
          "type": "string",
          "format": "date-time"
        },
        "seen_count": {
          "type": "integer",
          "minimum": 1
        },
        "notified_event_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "streams": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_urls": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^https?://\\S+$"
          }
        },
        "open_access": {
          "type": "boolean"
        },
        "is_preprint": {
          "type": "boolean"
        },
        "repository_versions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "notified_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "work_id",
        "event_type",
        "occurred_at",
        "notified_at",
        "source",
        "source_field",
        "source_url",
        "precision",
        "confidence"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "work_id": {
          "type": "string",
          "minLength": 1
        },
        "event_type": {
          "type": "string",
          "enum": [
            "version_of_record_first_online",
            "first_formal_indexing",
            "formal_proceedings_release",
            "oa_fulltext_first_available",
            "author_accepted_manuscript_first_available",
            "embargo_lifted",
            "preprint_to_peer_reviewed_upgrade",
            "formal_version_verified"
          ]
        },
        "occurred_at": {
          "type": "string",
          "minLength": 1
        },
        "notified_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_url": {
          "type": "string",
          "pattern": "^https?://\\S+$"
        },
        "source_field": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "precision": {
          "type": "string",
          "enum": [
            "date",
            "timestamp",
            "unknown"
          ]
        },
        "confidence": {
          "type": "string",
          "enum": [
            "publisher_verified",
            "publisher_supplied_citation",
            "provider_metadata",
            "source_metadata",
            "manual_review"
          ]
        }
      }
    }
  }
}
